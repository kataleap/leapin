# These variables are validated at startup by src/lib/env.ts. With
# NODE_ENV=production every non-commented variable below is REQUIRED and the
# app refuses to boot without it — a missing Postmark token used to mean every
# email silently failed with no signal but "failed" rows in notification_log.
# In development the third-party keys (Moyasar, Postmark, bank details) are
# optional so the app still runs without them; those features fail closed.
# Commented-out variables are genuinely optional and have defaults in code.

# Local Postgres, e.g. via: brew services start postgresql@16 (or Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leapin_dev?schema=public"
# A real, empty database on the same server, used only to validate migrations
# before applying them (create once with: createdb leapin_shadow)
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leapin_shadow?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_URL="http://localhost:3000"

NODE_ENV="development"

# Local-disk root for uploaded documents_vault files (Phase 2 §4 — never
# served directly; always behind the protected /api/documents/[id]/file
# route). Optional — defaults to <repo>/storage/documents if unset.
# DOCUMENTS_STORAGE_DIR="/absolute/path/to/storage/documents"

# Moyasar payment gateway (Phase 3 — Sandbox only; a provisional technical
# choice, not yet commercially approved — see مستند_نطاق_المرحلة_الثالثة.md §3.2).
# Get Sandbox keys from a Moyasar test account dashboard.
MOYASAR_SECRET_KEY="sk_test_xxxxxxxxxxxx"
# Configured on Moyasar's dashboard as the shared webhook secret; must match
# what src/lib/payments/moyasar.ts verifies against the webhook payload's
# secret_token field (confirm the exact mechanism against Moyasar's live docs).
MOYASAR_WEBHOOK_SECRET="replace-with-a-generated-secret"
# Optional — defaults to https://api.moyasar.com/v1 in code.
# MOYASAR_BASE_URL="https://api.moyasar.com/v1"

# Bank account details shown to a client paying by bank transfer — placeholder
# values, need sign-off from finance/management before going live.
BANK_TRANSFER_BANK_NAME="اسم البنك"
BANK_TRANSFER_ACCOUNT_NAME="اسم الحساب"
BANK_TRANSFER_IBAN="SAxxxxxxxxxxxxxxxxxxxxxx"

# Postmark transactional email (Phase 4 — a provisional technical choice,
# not yet commercially approved — see مستند_نطاق_المرحلة_الرابعة.md §4.2).
# Get a Server Token from a Postmark account's server settings.
POSTMARK_SERVER_TOKEN="replace-with-a-postmark-server-token"
# Must be a verified Sender Signature or domain on the Postmark account.
POSTMARK_FROM_EMAIL="noreply@example.com"
# Configured as HTTP Basic Auth on the webhook URL in Postmark's dashboard
# (Postmark has no payload-signature scheme like Moyasar's) — must match
# what src/lib/email/postmark.ts verifies against the Authorization header.
POSTMARK_WEBHOOK_USERNAME="replace-with-a-generated-username"
POSTMARK_WEBHOOK_PASSWORD="replace-with-a-generated-secret"
# Optional — defaults to https://api.postmarkapp.com in code.
# POSTMARK_BASE_URL="https://api.postmarkapp.com"
