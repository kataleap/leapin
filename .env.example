# Local Postgres, e.g. via: brew services start postgresql@16 (or Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leapin_dev?schema=public"
# A real, empty database on the same server, used only to validate migrations
# before applying them (create once with: createdb leapin_shadow)
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leapin_shadow?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_URL="http://localhost:3000"

NODE_ENV="development"

# Local-disk root for uploaded documents_vault files (Phase 2 §4 — never
# served directly; always behind the protected /api/documents/[id]/file
# route). Optional — defaults to <repo>/storage/documents if unset.
# DOCUMENTS_STORAGE_DIR="/absolute/path/to/storage/documents"
