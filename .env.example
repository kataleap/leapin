# Local Postgres, e.g. via: docker run --name leapin-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leapin_dev?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_URL="http://localhost:3000"

NODE_ENV="development"
